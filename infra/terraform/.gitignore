# Terraform state — never commit (may contain secrets)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log

# Saved plans
tfplan
*.tfplan

# Variable files that may hold subscription IDs / secrets
*.tfvars
*.tfvars.json
!example.tfvars

# Generated jumpbox SSH private key — must never be committed
jumpbox_id_ed25519
jumpbox_id_ed25519.pub
